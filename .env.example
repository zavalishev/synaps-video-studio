# AI Video Studio — ваши провайдеры. Скопируйте в .env и заполните: cp .env.example .env
# Your providers. Copy to .env and fill in. .env is in .gitignore — never commit it.
#
# Проверка / check:  studio/bin/studio doctor
# Ключи читают только инструменты студии (studio voice / studio image) и никогда их не печатают.
# Keys are read only by the studio tools and are never printed.
#
# Всё необязательно: без провайдеров студия делает ролики без голоса и без сгенерированных
# картинок (музыка, текст, графика кодом, 3D в Blender). Everything is optional.

# ─────────────────────────────── ОЗВУЧКА / VOICE ───────────────────────────────
# openai | elevenlabs | command | none
VOICE_PROVIDER=none

# --- OpenAI TTS (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts      # понимает --style (указания диктору) / supports --style
# OPENAI_TTS_VOICE=onyx                 # alloy ash ballad coral echo fable nova onyx sage shimmer verse marin cedar

# --- ElevenLabs (https://elevenlabs.io → Developers → API Keys)
# Свой голос: Voices → Add voice → Instant/Professional Voice Clone, затем скопируйте Voice ID.
# Your own cloned voice works the same way: paste its Voice ID.
# Тайминги слов приходят вместе с аудио — whisper не нужен. Word timings come with the audio.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # или eleven_flash_v2_5 / eleven_turbo_v2_5 (быстрее, дешевле)
# ELEVENLABS_STABILITY=0.5                  # 0..1, необязательно / optional voice_settings
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEED=1.0

# --- command: любая своя программа TTS (Kimi-Audio, Silero, Piper, XTTS, F5-TTS, свой сервер…)
# Any local or third-party TTS. Placeholders are substituted shell-quoted:
#   {text_file}  файл с текстом реплики (UTF-8) / text of the line
#   {out_wav}    куда записать аудио (wav/mp3/любой формат ffmpeg) / where to write audio
#   {voice}      голос (--voice, "voice" в lines.json или VOICE_COMMAND_VOICE)
#   {lang}       язык (--lang, по умолчанию ru)
#   {style_file} файл с указаниями диктору (--style), может быть пустым
#   {words_json} (необязательно) запишите сюда [{"text","start","end"}] в секундах — тогда ASR не нужен
# Примеры / examples:
#   VOICE_COMMAND=python3 ~/tts/kimi_tts.py --text-file {text_file} --out {out_wav}
#   VOICE_COMMAND=piper --model ~/piper/ru_RU-irina-medium.onnx --output_file {out_wav} < {text_file}
#   VOICE_COMMAND=curl -sf -X POST http://localhost:8020/tts --data-binary @{text_file} -o {out_wav}
# VOICE_COMMAND=
# VOICE_COMMAND_VOICE=default
# VOICE_COMMAND_TIMEOUT_SEC=600

# ─────────────────────────────── КАРТИНКИ / IMAGES ───────────────────────────────
# openai | gemini | command | none
IMAGE_PROVIDER=none

# --- OpenAI Images (тот же OPENAI_API_KEY)
# gpt-image-1 умеет прозрачный фон и референсы (--ref). dall-e-3 — без них.
# gpt-image-1 supports transparent backgrounds and reference images; dall-e-3 does not.
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Google Gemini (https://aistudio.google.com/apikey)
# Референсы — да; прозрачного фона нет (для вырезок просим белый фон → IMAGE_BG_COMMAND ниже);
# размер задаётся соотношением сторон, --quality не влияет.
# References: yes. No native transparency (white background is requested; see IMAGE_BG_COMMAND).
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- command: своя программа картинок (ComfyUI, Stable Diffusion, свой сервер…)
#   {prompt_file} {out_png} {size} {width} {height} {quality} {background} {refs}
#   {refs} — пути референсов JPEG через запятую (может быть пусто)
#   IMAGE_COMMAND=python3 ~/sd/gen.py --prompt-file {prompt_file} --w {width} --h {height} --out {out_png}
# IMAGE_COMMAND=
# IMAGE_COMMAND_TRANSPARENT=0          # 1 — если ваша программа сама отдаёт прозрачный PNG
# IMAGE_TIMEOUT_SEC=600

# --- Удаление фона (необязательно) — для провайдеров без прозрачности (Gemini, dall-e, command)
# Optional background removal for providers without transparency, e.g. rembg (pip install "rembg[cli]"):
# IMAGE_BG_COMMAND=rembg i {in_png} {out_png}

# ─────────────────────────── ТАЙМИНГИ СЛОВ / WORD TIMINGS ───────────────────────────
# Нужны для субтитров по словам и склеек на словах. Порядок при auto:
#   1) из ответа озвучки (ElevenLabs, command с {words_json}) — бесплатно
#   2) whisper.cpp локально (macOS: brew install whisper-cpp) — бесплатно
#   3) OpenAI transcription, если есть OPENAI_API_KEY — платно, копейки
#   4) пропорционально длине слов — с предупреждением
# auto | whisper | openai | none
ASR_PROVIDER=auto
# WHISPER_CPP_MODEL=~/models/ggml-small.bin   # https://huggingface.co/ggerganov/whisper.cpp (ggml-small.bin)
# WHISPER_CPP_BIN=whisper-cli
# OPENAI_ASR_MODEL=whisper-1

# ─────────────────────────────── ПРОЧЕЕ / OTHER ───────────────────────────────
# OPENAI_BASE_URL=https://api.openai.com/v1                       # совместимый сервер / compatible server
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# BLENDER=/Applications/Blender.app/Contents/MacOS/Blender        # если не нашёлся сам / if not auto-detected
# CLAUDE_BIN=~/.local/bin/claude

# AI Video Studio — ваши провайдеры. Скопируйте в .env и заполните: cp .env.example .env
# Your providers. Copy to .env and fill in. .env is in .gitignore — never commit it.
#
# Проверка / check:  studio/bin/studio doctor
# Ключи читают только инструменты студии (studio voice / studio image) и никогда их не печатают.
# Keys are read only by the studio tools and are never printed.
#
# Всё необязательно: без провайдеров студия делает ролики без голоса и без сгенерированных
# картинок (музыка, текст, графика кодом, 3D в Blender). Everything is optional.

# ─────────────────────────────── ОЗВУЧКА / VOICE ───────────────────────────────
# openai | elevenlabs | command | none
VOICE_PROVIDER=none

# --- OpenAI TTS (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts      # понимает --style (указания диктору) / supports --style
# OPENAI_TTS_VOICE=onyx                 # alloy ash ballad coral echo fable nova onyx sage shimmer verse marin cedar

# --- ElevenLabs (https://elevenlabs.io → Developers → API Keys)
# У ключа должно быть право Text to Speech (у новых ключей права выбираются при создании).
# Свой голос: Voices → Add voice → Instant Voice Clone (платный план от Starter) или
# Professional Voice Clone (от Creator), затем скопируйте Voice ID.
# The API key needs the Text-to-Speech permission. Cloning needs a paid plan (Instant: Starter+,
# Professional: Creator+). Your own cloned voice works the same way: paste its Voice ID.
# Тайминги слов приходят вместе с аудио — whisper не нужен. Word timings come with the audio.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # или eleven_flash_v2_5 / eleven_turbo_v2_5 (быстрее, дешевле)
# ELEVENLABS_STABILITY=0.5                  # 0..1, необязательно / optional voice_settings
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEED=1.0

# --- command: любая своя программа TTS (Piper, Silero, F5-TTS, XTTS, Kimi-Audio, свой сервер…)
# Any local or third-party TTS. Команда выполняется через sh; {плейсхолдер} заменяется уже
# закавыченной переменной ("$STUDIO_CMD_…"), поэтому НЕ берите плейсхолдеры в кавычки:
#   правильно: say -v {voice} -f {text_file}      ошибка: say -v "{voice}" -f '{text_file}'
# The command runs via sh; each {placeholder} becomes an already-quoted variable — never put
# placeholders inside quotes yourself (studio doctor reports it). Placeholders:
#   {text_file}  файл с текстом реплики (UTF-8) / text of the line
#   {out_wav}    куда записать аудио (wav/mp3/любой формат ffmpeg) / where to write audio
#   {voice}      голос (--voice, "voice" в lines.json или VOICE_COMMAND_VOICE)
#   {lang}       язык (--lang, по умолчанию ru)
#   {style_file} файл с указаниями диктору (--style), может быть пустым
#   {words_json} (необязательно) запишите сюда [{"text","start","end"}] в секундах — тогда ASR не нужен
# Примеры / examples:
#   macOS, бесплатно, без ключей (голос Milena: Системные настройки → Универсальный доступ →
#   Устный контент → Системный голос → Управлять голосами) / free on a Mac:
#   VOICE_COMMAND=say -v Milena -r 150 -f {text_file} -o {out_wav} --data-format=LEI16@22050   (-r — слов в минуту; по умолчанию быстро)
#   VOICE_COMMAND=piper --model ~/piper/ru_RU-irina-medium.onnx --output_file {out_wav} < {text_file}
#   VOICE_COMMAND=curl -sf -X POST http://localhost:8020/tts --data-binary @{text_file} -o {out_wav}
#   Своя обёртка (Kimi-Audio и т.п.; Kimi-Audio — модель для видеокарты NVIDIA, на Mac — через
#   удалённый сервер и curl): / your own wrapper script:
#   VOICE_COMMAND=python3 ~/tts/my_tts.py --text-file {text_file} --out {out_wav}
# Токены своей программы можно держать здесь же (например KIMI_API_TOKEN=…): переменные с
# KEY/TOKEN/SECRET/PASS в имени маскируются в выводе ошибок.
# VOICE_COMMAND=
# VOICE_COMMAND_VOICE=default
# VOICE_COMMAND_TIMEOUT_SEC=600

# ─────────────────────────────── КАРТИНКИ / IMAGES ───────────────────────────────
# openai | gemini | codex | command | none
IMAGE_PROVIDER=none

# --- Codex CLI по подписке ChatGPT (без ключа API): npm i -g @openai/codex, затем codex login
# Встроенный генератор Codex: прозрачный фон и референсы (--ref) — да; ~30–60 с на картинку;
# расход — лимит вашей подписки, отдельного счёта нет. Работает и при режиссёре Claude Code.
# Codex's built-in image generation on a ChatGPT subscription (no API key): transparency and refs.
# IMAGE_PROVIDER=codex

# --- OpenAI Images (тот же OPENAI_API_KEY)
# gpt-image-1 умеет прозрачный фон и референсы (--ref). dall-e-3 — без них.
# gpt-image-1 supports transparent backgrounds and reference images; dall-e-3 does not.
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Google Gemini (https://aistudio.google.com/apikey)
# Референсы — да; прозрачного фона нет (для вырезок просим белый фон → IMAGE_BG_COMMAND ниже);
# размер задаётся соотношением сторон, --quality не влияет.
# References: yes. No native transparency (white background is requested; see IMAGE_BG_COMMAND).
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- command: своя программа картинок (ComfyUI, Stable Diffusion, свой сервер…)
#   плейсхолдеры — без кавычек, как у VOICE_COMMAND / no quotes around placeholders
#   {prompt_file} {out_png} {size} {width} {height} {quality} {background} {refs}
#   {refs} — пути референсов JPEG через запятую (может быть пусто)
#   IMAGE_COMMAND=python3 ~/sd/gen.py --prompt-file {prompt_file} --w {width} --h {height} --out {out_png}
# IMAGE_COMMAND=
# IMAGE_COMMAND_TRANSPARENT=0          # 1 — если ваша программа сама отдаёт прозрачный PNG
# IMAGE_TIMEOUT_SEC=600

# --- Удаление фона (необязательно) — для провайдеров без прозрачности (Gemini, dall-e, command)
# Optional background removal for providers without transparency, e.g. rembg (pip install "rembg[cli]"):
# IMAGE_BG_COMMAND=rembg i {in_png} {out_png}

# ─────────────────────────────── МУЗЫКА / MUSIC ───────────────────────────────
# Своя музыка под ролик: studio music --make "описание" --sec N (или --plan по секциям).
# Выключено — только каталог студии (studio music, CC0).
# Generated music for each video; off = the bundled CC0 catalog only.
MUSIC_PROVIDER=none
# --- ElevenLabs Music (тот же ELEVENLABS_API_KEY; платный план — коммерческое использование).
# Кредиты общие с озвучкой: ~14 кредитов за секунду музыки (трек на 30 с ≈ 400).
# Shares credits with ElevenLabs TTS: roughly 14 credits per second of music.
# MUSIC_PROVIDER=elevenlabs
# ELEVENLABS_MUSIC_MODEL=music_v1           # music_v1 понимает план по секциям (--plan)
# --- Своя программа: {prompt_file} {plan_file} {out_mp3} {seconds} — без кавычек вокруг.
# MUSIC_PROVIDER=command
# MUSIC_COMMAND=python3 ~/music/gen.py --prompt-file {prompt_file} --sec {seconds} --out {out_mp3}
# MUSIC_COMMAND_TIMEOUT_SEC=600

# ─────────────────────────── ТАЙМИНГИ СЛОВ / WORD TIMINGS ───────────────────────────
# Нужны для субтитров по словам и склеек на словах. Порядок при auto:
#   1) из ответа озвучки (ElevenLabs, command с {words_json}) — бесплатно
#   2) whisper.cpp локально (macOS: brew install whisper-cpp) — бесплатно
#   3) OpenAI transcription, если есть OPENAI_API_KEY — платно, копейки
#   4) пропорционально длине слов — с предупреждением
# auto | whisper | openai | none
ASR_PROVIDER=auto
# WHISPER_CPP_MODEL=~/models/ggml-small.bin   # npm run setup скачает ggml-small.bin с проверкой SHA-256
# WHISPER_CPP_BIN=whisper-cli
# OPENAI_ASR_MODEL=whisper-1

# ─────────────────────────────── ПРОЧЕЕ / OTHER ───────────────────────────────
# OPENAI_BASE_URL=https://api.openai.com/v1                       # совместимый сервер / compatible server
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# BLENDER=/Applications/Blender.app/Contents/MacOS/Blender        # если не нашёлся сам / if not auto-detected
# CLAUDE_BIN=~/.local/bin/claude
# CODEX_BIN=/opt/homebrew/bin/codex
# CODEX_HOME=~/.codex                                              # где Codex хранит вход и картинки

# ─────────────────────────────── РЕЖИССЁР / DIRECTOR ───────────────────────────────
# Кто ведёт ролик в npm run make: claude (Claude Code, подписка Claude) | codex (Codex CLI,
# подписка ChatGPT) | auto — какой установлен, если оба — Claude Code. Флаг --agent важнее.
# Director agent for npm run make: claude | codex | auto. The --agent flag wins.
# STUDIO_AGENT=auto

# ─────────────────────────────── СЕРВЕР / SERVER MODE ───────────────────────────────
# Студия на сервере или в контейнере (без видеокарты и без интернета):
# STUDIO_JOBS_DIR=/project/jobs          # где папки роликов (по умолчанию jobs/ в репозитории)
# STUDIO_CACHE_DIR=/project/.cache       # кэш озвучки, картинок, замков рендера
# STUDIO_GL=swangle                      # GL рендера без видеокарты (по умолчанию angle)
# STUDIO_RENDER_CONCURRENCY=3            # потоков рендера (по умолчанию от числа ядер машины)
# STUDIO_FONTS_DIR=/opt/fonts            # зеркало шрифтов: node scripts/fonts-offline.mjs /opt/fonts
# STUDIO_CODEX_ARGS=["-c","model_provider=\"pool\""]   # свои аргументы codex exec (JSON), например свой прокси
# Рендер видео на другой машине (например, Mac с видеочипом): программа получает готовый бандл
# и возвращает mp4; не вышло — рендер здесь же. Рендерер бандла — scripts/render-bundle.mjs.
# STUDIO_RENDER_COMMAND=node scripts/render-bundle.mjs {bundle} {composition} {props_file} {out} {scale} {crf} {frames}
# STUDIO_RENDER_COMMAND_TIMEOUT_SEC=2400
